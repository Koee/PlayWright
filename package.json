{
  "name": "playwright",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "cleanup:screenshots": "node scripts/cleanup-screenshots.js",
    "test": "playwright test",
    "test:checkout": "playwright test tests/ui/checkout/checkout-flow.spec.ts",
    "test:copy": "playwright test tests/ui/checkout/copy-functionality.spec.ts",
    "test:ui-bulk": "playwright test tests/ui/checkout/checkout-bulk-flow.spec.ts",
    "test:list": "playwright test --list",
    "test:api-template:guest": "playwright test tests/api/checkout/checkout-api-template.spec.ts --grep \"@api-template-guest\"",
    "test:api-template:login": "playwright test tests/api/checkout/checkout-api-template.spec.ts --grep \"@api-template-login\"",
    "test:api-performance:guest": "playwright test tests/api/checkout/checkout-api-performance.spec.ts --grep \"@api-performance-guest\"",
    "test:api-performance:login": "playwright test tests/api/checkout/checkout-api-performance.spec.ts --grep \"@api-performance-login\"",
    "k6:version": "node scripts/run-k6-checkout.js --version",
    "k6:checkout": "node scripts/run-k6-checkout.js --mode guest",
    "k6:checkout:guest": "node scripts/run-k6-checkout.js --mode guest",
    "k6:checkout:login": "node scripts/run-k6-checkout.js --mode login",
    "k6:checkout:json": "node scripts/run-k6-checkout.js --mode guest --json",
    "k6:checkout:guest:json": "node scripts/run-k6-checkout.js --mode guest --json",
    "k6:checkout:guest:smoke": "node scripts/run-k6-checkout.js --mode guest --json --smoke",
    "k6:checkout:login:json": "node scripts/run-k6-checkout.js --mode login --json",
    "k6:mlbl-gift-order": "node scripts/run-k6-mlbl-gift-order.js",
    "k6:mlbl-gift-order:json": "node scripts/run-k6-mlbl-gift-order.js --json",
    "k6:mlbl-gift-order:smoke": "node scripts/run-k6-mlbl-gift-order.js --json --smoke",
    "k6:build": "tsc --project tsconfig.k6.json",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Koee/playwright.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Koee/playwright/issues"
  },
  "homepage": "https://github.com/Koee/playwright#readme",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
