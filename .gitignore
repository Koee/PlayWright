# =========================================================
# NODE / PACKAGE MANAGERS
# =========================================================
node_modules/
node_modules/.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================================================
# PLAYWRIGHT OUTPUTS
# =========================================================
test-results/
playwright-report/
blob-report/
html-report/
coverage/

# Screenshots / videos / traces
screenshots/
videos/
traces/
trace/
test-artifacts/
artifacts/
err-videos/

# Video / audio binaries (agent không đọc được, tốn token)
*.webm
*.mp4

# HTTP Archive — chứa full request/response, có thể có credentials
*.har

# Visual snapshot binaries
*.png.snap
snapshots/
__snapshots__/

# Playwright cache & auth
/playwright/.cache/
/playwright/.auth/
.playwright/
.playwright-mcp/

# Playwright storageState (session/cookie files)
auth/*.json
fixtures/auth/*.json
**/storageState.json

# Trace archives
*.zip

# =========================================================
# BUILD OUTPUT
# =========================================================
dist/
build/
out/
.tmp/
.temp/

# =========================================================
# REPORTING TOOLS
# =========================================================
allure-results/
allure-report/
junit-report/
report/

# =========================================================
# LOGS
# =========================================================
logs/
*.log

# =========================================================
# ENVIRONMENT VARIABLES
# =========================================================
.env
.env.*
!.env.example
!.env.test.example
test-data/env/.env
!test-data/env/.env.example
test-data/k6/
test-data/sheet/

# Local override files (chứa path tuyệt đối, config local)
*.local
*.local.*
playwright.config.local.ts

# =========================================================
# IDE / EDITOR
# =========================================================
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

.idea/

# =========================================================
# TYPESCRIPT
# =========================================================
*.tsbuildinfo

# =========================================================
# AI / AGENT CACHE
# =========================================================
.cursor/
.cline/
.codex/
.ai/
.cache/

# Agent rule files — prevent agent từ đọc chính rule của mình (tránh loop)
.clinerules
.cursorrules
.aider*
.continue/

# =========================================================
# GENERATED FILES
# =========================================================
generated/
tmp/
temp/

# =========================================================
# OS FILES
# =========================================================
.DS_Store
Thumbs.db
