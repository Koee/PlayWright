### 🟡 Warning — nên sửa trong sprint này

---

#### W1. Test name mơ hồ [AUTHOR] [REVIEWER]

```typescript
// ❌ Không rõ test đang verify gì
test('test 1', ...)
test('check button', ...)
test('login', ...)

// ✅ Pattern: should [kết quả mong đợi] when [điều kiện / hành động]
test('should show error message when login with wrong password', ...)
test('should redirect to dashboard when login successfully', ...)
test('should disable submit button when form has validation errors', ...)
```

---

#### W2. Thiếu `beforeEach` / `afterEach` [AUTHOR] [REVIEWER]

```typescript
// ❌ Setup lặp lại trong mỗi test
test('test A', async ({ page }) => {
  await page.goto('/products');
  await page.getByRole('link', { name: 'Add Product' }).click();
  // ...
});
test('test B', async ({ page }) => {
  await page.goto('/products');
  await page.getByRole('link', { name: 'Add Product' }).click();
  // ...
});

// ✅ Extract ra beforeEach
test.describe('Product management', () => {
  test.beforeEach(async ({ page }) => {
    await page.goto('/products');
    await page.getByRole('link', { name: 'Add Product' }).click();
  });

  test('test A', async ({ page }) => { ... });
  test('test B', async ({ page }) => { ... });
});
```

---

#### W3. POM khi có reuse ở 2+ file [AUTHOR] [REVIEWER]

```typescript
// ❌ Sai — cùng selector viết ở nhiều file
// file A: await page.getByTestId('cart-icon').click();
// file B: await page.getByTestId('cart-icon').click();

// ✅ Đúng — tạo Page Object khi interaction xuất hiện ở 2+ test file
// /pages/CartPage.ts
export class CartPage {
  constructor(private page: Page) {}

  async openCart() {
    await this.page.getByTestId('cart-icon').click();
    await expect(this.page.getByTestId('cart-drawer')).toBeVisible();
  }

  async getItemCount() {
    return this.page.getByTestId('cart-count').textContent();
  }
}
```

> Tiêu chí để tạo POM: **reuse ở 2+ file**, không phải số lượng action.

