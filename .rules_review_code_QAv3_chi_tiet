#### C13. Không dùng `storageState` cho Authentication [AUTHOR] [REVIEWER]

```typescript
// ❌ Sai — login trong mỗi test → chậm gấp 10x, tốn quota
test('view orders', async ({ page }) => {
  await page.goto('/login');
  await page.fill('[name="email"]', process.env.TEST_USER_EMAIL!);
  await page.fill('[name="password"]', process.env.TEST_USER_PASSWORD!);
  await page.click('[type="submit"]');
  // ... sau đó mới test
});

// ✅ Đúng — setup một lần trong globalSetup, inject vào mọi test
// playwright.config.ts
export default defineConfig({
  globalSetup: './global-setup.ts',
  use: {
    storageState: '.auth/user.json',  // inject cookie/localStorage đã login
  },
});

// global-setup.ts
async function globalSetup() {
  const browser = await chromium.launch();
  const page = await browser.newPage();
  await page.goto(`${process.env.BASE_URL}/login`);
  await page.fill('[name="email"]', process.env.TEST_USER_EMAIL!);
  await page.fill('[name="password"]', process.env.TEST_USER_PASSWORD!);
  await page.click('[type="submit"]');
  await page.waitForURL('**/dashboard');
  await page.context().storageState({ path: '.auth/user.json' });
  await browser.close();
}
```

> Thêm `.auth/` vào `.gitignore`.

