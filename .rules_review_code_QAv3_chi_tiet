### 🟢 Suggestion — nice to have

---

#### S1. Dùng `test.step()` để chia bước

```typescript
test('checkout flow', async ({ page }) => {
  await test.step('Add product to cart', async () => {
    await page.getByTestId('product-card').first().getByRole('button', { name: 'Add' }).click();
  });

  await test.step('Proceed to checkout', async () => {
    await page.getByTestId('cart-icon').click();
    await page.getByRole('button', { name: 'Checkout' }).click();
  });

  await test.step('Complete payment', async () => {
    await page.getByLabel('Card number').fill('4242424242424242');
    await page.getByRole('button', { name: 'Pay now' }).click();
    await expect(page.getByTestId('success-page')).toBeVisible();
  });
});
```

> Các step sẽ hiển thị riêng trong HTML report — dễ xác định bước nào fail.

---

#### S2. Dùng `test.each()` cho nhiều bộ dữ liệu

```typescript
// ❌ Copy-paste test
test('login with gmail', ...)
test('login with microsoft', ...)
test('login with github', ...)

// ✅ Dùng test.each
const providers = [
  { name: 'Gmail', selector: '[data-testid="google-login"]', expectedUrl: '/oauth/google' },
  { name: 'Microsoft', selector: '[data-testid="ms-login"]', expectedUrl: '/oauth/microsoft' },
  { name: 'GitHub', selector: '[data-testid="github-login"]', expectedUrl: '/oauth/github' },
];

for (const { name, selector, expectedUrl } of providers) {
  test(`should redirect to ${name} OAuth when clicking ${name} login button`, async ({ page }) => {
    await page.goto('/login');
    const [popup] = await Promise.all([
      page.waitForEvent('popup'),
      page.locator(selector).click(),
    ]);
    await expect(popup).toHaveURL(new RegExp(expectedUrl));
  });
}
```

