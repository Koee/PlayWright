# Playwright API login used by login checkout mode.
# Guest/no-login mode does not need these values.
CHECKOUT_API_LOGIN_URL=
CHECKOUT_API_LOGIN_METHOD=POST
CHECKOUT_API_LOGIN_BODY={"username":"test","password":"test"}
CHECKOUT_API_TOKEN_PATH=token
CHECKOUT_API_AUTH_HEADER_NAME=Authorization
CHECKOUT_API_TOKEN_PREFIX=Bearer

# Optional response validation for checkout API.
# Set CHECKOUT_API_ORDER_ID_PATH when the response has a real order identifier, for example data.order_id.
CHECKOUT_API_ORDER_ID_PATH=
CHECKOUT_API_SUCCESS_PATH=success
CHECKOUT_API_STATUS_PATH=status
